    { "source": "/wedstrijdregels-laddercompetitie", "destination": "/reglementen#ladder", "permanent": true },
    { "source": "/ngf-competitie-voorjaar-2026", "destination": "/ngf-competitie", "permanent": true },
    { "source": "/ngf-verzekeringen-voor-golfers", "destination": "/leden#verzekeringen", "permanent": true },
